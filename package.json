{
  "name": "onova.server.push",
  "version": "1.0.0",
  "description": "Pusher Auth REST API and Push notification polling for ChatKit",
  "dependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.0.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-flow": "^7.0.0",
    "@pusher/chatkit-server": "^0.12.2",
    "agenda": "^1.0.3",
    "babel-eslint": "^9.0.0",
    "body-parser": "^1.18.2",
    "dotenv": "^6.0.0",
    "express": "^4.16.3",
    "morgan": "1.9.0",
    "node-persist": "^2.1.0",
    "request": "^2.88.0",
    "rxjs": "^5.5.6",
    "winston": "2.4.1"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prod:build": "rimraf lib && babel *.js -d lib --ignore .test.js && cp -r config.json ./lib",
    "prod:start": "node lib/server.js",
    "prod:start-push": "node lib/index.js",
    "start": "yarn prod:build && yarn prod:start",
    "start-push": "yarn prod:build && yarn prod:start-push",
    "dev:start": "nodemon --ignore lib --exec babel-node server.js",
    "dev:start-push": "nodemon --ignore lib --exec babel-node index.js"
  },
  "devDependencies": {
    "@babel/node": "^7.0.0",
    "eslint": "^5.5.0",
    "eslint-config-prettier": "^3.0.1",
    "eslint-plugin-flowtype": "^2.46.2",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-prettier": "^2.6.0",
    "flow-bin": "^0.80.0",
    "nodemon": "^1.18.4",
    "prettier": "^1.14.2",
    "rimraf": "^2.6.2"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=8.11",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.push.git"
  },
  "private": true,
  "author": "Onova Team <hello@onova.co>",
  "nodemonConfig": {
    "ignore": [
      "lib/*"
    ],
    "delay": "2500"
  }
}
