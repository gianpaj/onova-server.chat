{
  "name": "onova.server.chat",
  "version": "2.0.0",
  "description": "Chat server for orders chatbot with Sendbird",
  "dependencies": {
    "@babel/cli": "^7.2.0",
    "@babel/core": "^7.2.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.3.0",
    "@babel/preset-env": "^7.3.0",
    "@babel/preset-flow": "^7.0.0",
    "agenda": "^1.0.3",
    "dotenv": "^6.0.0",
    "morgan": "^1.9.0",
    "node-persist": "^2.1.0",
    "request": "^2.88.0",
    "sendbird-platform-api": "1.2.0",
    "winston": "2.4.1"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prod:build": "rimraf lib && babel *.js -d lib --ignore .test.js && cp -r config.json ./lib",
    "prod:start": "node lib/server.js",
    "start": "yarn prod:build && yarn prod:start",
    "start:dev": "nodemon --ignore lib --exec babel-node server.js"
  },
  "devDependencies": {
    "@babel/node": "^7.0.0",
    "babel-eslint": "^10.0.1",
    "eslint": "^5.5.0",
    "eslint-config-prettier": "^6.0.0",
    "eslint-plugin-flowtype": "^3.2.0",
    "eslint-plugin-import": "^2.18.0",
    "eslint-plugin-prettier": "^3.1.0",
    "esm": "^3.0.84",
    "flow-bin": "^0.82.0",
    "nodemon": "^1.18.4",
    "prettier": "^1.16.0",
    "prettier-eslint-cli": "4.7.1",
    "rimraf": "^2.6.2"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=12",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.chat.git"
  },
  "private": true,
  "author": "Onova Team <hello@onova.co>",
  "nodemonConfig": {
    "ignore": [
      "lib/*"
    ],
    "delay": "2500"
  }
}
